# 基础模型（意图识别与话术生成）；也可用 MODEL_* 同名简写作为别名
FOUNDATION_MODEL_PROVIDER=openai
FOUNDATION_MODEL_API_KEY=
FOUNDATION_MODEL_BASE_URL=https://api.openai.com/v1
FOUNDATION_MODEL_NAME=gpt-4o-mini

# 视觉模型（客户图片的前置识别）；留空则复用上面的基础模型凭据
FOUNDATION_VISION_MODEL_NAME=
FOUNDATION_VISION_API_KEY=
FOUNDATION_VISION_BASE_URL=

# 身份令牌签名密钥；生产环境必填，否则启动即报错
PRESALES_SESSION_SECRET=

# 运行时数据目录（相对路径按启动目录解析为绝对路径后缓存）
PRESALES_DB_PATH=data/presales-demo.db
PRESALES_UPLOAD_DIR=data/uploads

# 只读引用的售前技能资源；留空则回退到相邻的「私域电商售前客服AI规划」目录
PRESALES_SKILL_ROOT=
PRESALES_KNOWLEDGE_BASE=
